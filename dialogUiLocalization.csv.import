[remap]

importer="csv_translation"
type="Translation"

[deps]

files=[ "res://dialogUiLocalization.en.translation", "res://dialogUiLocalization.zh_CN.translation" ]

source_file="res://dialogUiLocalization.csv"
dest_files=[ "res://dialogUiLocalization.en.translation", "res://dialogUiLocalization.zh_CN.translation" ]

[params]

compress=true
delimiter=0
