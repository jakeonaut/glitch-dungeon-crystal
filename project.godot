[internationalization]

locale/locale_filter_mode=1

[locale]

translations=PoolStringArray( "res://dialogUiLocalization.en.translation", "res://dialogUiLocalization.pt_BR.translation", "res://dialogUiLocalization.ru.translation", "res://dialogUiLocalization.zh_CN.translation", "res://dialogUiLocalization.fr.translation" )
translation_remaps={
"res://YosterFontBig.tres": PoolStringArray( "res://dialogBodyFontTheme_zh_CN.tres:zh_CN", "res://YosterFontBig_ru.tres:ru", "res://YosterFontBig_ru.tres:pt_BR", "res://YosterFontBig_ru.tres:fr" ),
"res://dialogBodyFontTheme.tres": PoolStringArray( "res://dialogBodyFontTheme_zh_CN.tres:zh_CN", "res://dialogBodyFontTheme_ru.tres:ru", "res://dialogBodyFontTheme_ru.tres:pt_BR", "res://dialogBodyFontTheme_ru.tres:fr" ),
"res://levels/common/FancyText.tres": PoolStringArray( "res://levels/common/FancyText_zh_CN.tres:zh_CN", "res://levels/common/FancyText_ru.tres:ru", "res://levels/common/FancyText_ru.tres:pt_BR", "res://levels/common/FancyText_ru.tres:fr" ),
"res://levels/common/UITheme_real.tres": PoolStringArray( "res://levels/common/UITheme_real_zh_CN.tres:zh_CN", "res://levels/common/UITheme_real_ru.tres:ru", "res://levels/common/UITheme_real_ru.tres:pt_BR", "res://levels/common/UITheme_real_ru.tres:fr" ),
"res://levels/common/UITheme_real_spaced.tres": PoolStringArray( "res://levels/common/UITheme_real_spaced_zh_CN.tres:zh_CN", "res://levels/common/UITheme_real_spaced_ru.tres:ru", "res://levels/common/UITheme_real_spaced_ru.tres:pt_BR", "res://levels/common/UITheme_real_spaced_ru.tres:fr" ),
"res://levels/common/UITheme_small.tres": PoolStringArray( "res://levels/common/UITheme_small_zh_CN.tres:zh_CN" ),
"res://pauseMenuTheme.tres": PoolStringArray( "res://pauseMenuTheme_zh_CN.tres:zh_CN", "res://pauseMenuTheme_ru.tres:ru", "res://pauseMenuTheme_ru.tres:pt_BR", "res://pauseMenuTheme_ru.tres:fr" ),
"res://pauseMenuThemeInputCondensed.tres": PoolStringArray( "res://pauseMenuThemeInputCondensed_ru.tres:ru", "res://pauseMenuThemeInputCondensed_ru.tres:pt_BR", "res://pauseMenuThemeInputCondensed_zh_CN.tres:zh_CN", "res://pauseMenuThemeInputCondensed_ru.tres:fr" ),
"res://uiTutorialFont.tres": PoolStringArray( "res://uiTutorialFont_zh_CN.tres:zh_CN", "res://uiTutorialFont_ru.tres:ru", "res://uiTutorialFont_ru.tres:pt_BR", "res://uiTutorialFont_ru.tres:fr" )
}
locale_filter=[ 0, [ "en", "es", "fr", "pt_BR", "ru", "zh_CN" ] ]

[physics]

3d/active_soft_world=false

[physics_2d]

motion_fix_enabled=true

[rendering]

quality/driver/fallback_to_gles2=true
2d/snapping/use_gpu_pixel_snap=true
quality/directional_shadow/size=256
quality/directional_shadow/size.mobile=256
quality/shadow_atlas/size=256
quality/shadow_atlas/size.mobile=256
quality/shadow_atlas/cubemap_size=256
quality/shadows/filter_mode=0
quality/reflections/texture_array_reflections=false
quality/reflections/high_quality_ggx=false
quality/shading/force_vertex_shading=true
quality/shading/force_lambert_over_burley=true
quality/shading/force_blinn_over_ggx=true
quality/spatial_partitioning/render_tree_balance=1.0
quality/lightmapping/use_bicubic_sampling=false
quality/subsurface_scattering/quality=0
quality/reflections/atlas_size=256
