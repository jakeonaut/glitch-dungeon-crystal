code = "shader_type spatial;
render_mode specular_schlick_ggx;

uniform float HowShiny = 2;
uniform float Roughness = 0.2;
uniform float alpha2 = 0.5;
uniform bool should_use_vertex_color = true;
uniform sampler2D texture_albedo : hint_albedo;

varying smooth vec3 our_color;

void vertex() {
// Output:0
  our_color = VERTEX;
}

void fragment() {
// ColorUniform:4;
	vec3 n_out4p0 = our_color;

// ScalarUniform:2
	float n_out2p0 = HowShiny;

// ScalarUniform:3
	float n_out3p0 = Roughness;

  if (should_use_vertex_color) {
	 ALBEDO = our_color;
  } else {
    ALBEDO = texture(texture_albedo, UV).rgb;
  }
	METALLIC = n_out2p0;
	ROUGHNESS = n_out3p0;
  ALPHA = alpha2;

}

void light() {
// Output:0

}"

