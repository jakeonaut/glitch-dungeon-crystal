[gd_resource type="Shader" format=2]

[resource]
code = "shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx,unshaded;
uniform sampler2D base_palette : hint_albedo;

uniform int palettesize = 16;

vec3 getpalettecolor(int x) {
    vec2 coord = vec2(float(x)/float(palettesize),0);
    return texture(base_palette, coord).rgb;
}

// https://unlimited3d.wordpress.com/2020/01/08/srgb-color-space-in-opengl/
float Convert_sRGB_FromLinear (float theLinearValue) {
  return theLinearValue <= 0.0031308
       ? theLinearValue * 12.92
       : pow (theLinearValue, 1.0/2.4) * 1.055 - 0.055;
}

void fragment() {
    vec4 incolor = texture(SCREEN_TEXTURE, SCREEN_UV);
    float fdelta = mod(256.0 * incolor.r, 16.0);
    float mod2 = mod(fdelta, float(palettesize));
    int delta = int(mod2);
    vec3 color = getpalettecolor(delta);
    ALBEDO.rgb = color.rgb;
    ALPHA = incolor.a;
}
"
